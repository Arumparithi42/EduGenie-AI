# Copy this file to ".env" (in this same EduGenie folder) and fill in your key.
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use. "gemini-flash-latest" always points to the newest Flash model.
# You can pin a specific model instead, e.g. GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL=gemini-flash-latest

# When Gemini answers 503 "high demand" / 429 rate limit, EduGenie retries the same model
# GEMINI_MAX_RETRIES times (waiting ~2 s, then ~4 s), then tries these backup models in order.
# Set GEMINI_FALLBACK_MODELS=none to disable the fallback.
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest
GEMINI_MAX_RETRIES=2

# Explanation backend: auto | local | gemini
#   auto   -> use local LaMini-Flan-T5 if requirements-local.txt is installed, else Gemini
EXPLAIN_BACKEND=auto

# Load the local model at startup instead of on the first "Explain" request (true/false)
PRELOAD_LOCAL_MODEL=false

LOG_LEVEL=INFO
