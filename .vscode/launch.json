{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "EduGenie: Run server (uvicorn)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
            "cwd": "${workspaceFolder}/EduGenie",
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "EduGenie: Run tests (pytest)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-v"],
            "cwd": "${workspaceFolder}/EduGenie",
            "justMyCode": true
        }
    ]
}
